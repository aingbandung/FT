rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid}    { allow read, write: if request.auth.uid == uid; }
    match /circles/{code} {
      allow read, create: if request.auth != null;
      match /places/{id} { allow read, write: if request.auth != null; }
      match /events/{id} { allow read, create: if request.auth != null; }
    }
    match /locations/{uid} {
      allow write: if request.auth.uid == uid;
      allow read: if request.auth != null;   // tighten later: same-circle members only
    }
    match /history/{id} {
      allow create: if request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null;   // tighten later: same-circle members only
    }
  }
}
